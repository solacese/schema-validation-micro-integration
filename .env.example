# Solace Broker — Input (consume IoT messages)
SOLACE_INPUT_BROKER=tcp://solace-broker:55555
SOLACE_INPUT_VPN=default
SOLACE_INPUT_USERNAME=default
SOLACE_INPUT_PASSWORD=default

# Solace Broker — Output (publish validated results)
# Set to same as input for single-broker mode
SOLACE_OUTPUT_BROKER=tcp://solace-broker:55555
SOLACE_OUTPUT_VPN=default
SOLACE_OUTPUT_USERNAME=default
SOLACE_OUTPUT_PASSWORD=default

# Legacy single-broker fallback (used if SOLACE_INPUT/OUTPUT not set)
URL=tcp://solace-broker:55555
VPN=default
USER=default
PWD=default

# For Solace Cloud dual-broker:
# SOLACE_INPUT_BROKER=wss://input-broker.messaging.solace.cloud:443
# SOLACE_INPUT_VPN=source-vpn
# SOLACE_INPUT_USERNAME=solace-cloud-client
# SOLACE_INPUT_PASSWORD=<input-password>
# SOLACE_OUTPUT_BROKER=wss://output-broker.messaging.solace.cloud:443
# SOLACE_OUTPUT_VPN=target-vpn
# SOLACE_OUTPUT_USERNAME=solace-cloud-client
# SOLACE_OUTPUT_PASSWORD=<output-password>

# Schema Registry
SCHEMA_REGISTRY_BASE_URL=http://schema-registry-backend:8080/apis/registry/v3
SCHEMA_REGISTRY_USERNAME=sr-readonly
SCHEMA_REGISTRY_PASSWORD=roPassword

# Broker SEMP admin
SEMP_URL=http://solace-broker:8080
SEMP_ADMIN_USER=admin
SEMP_ADMIN_PASSWORD=admin
