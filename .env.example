# Solace Broker — Input (consume IoT messages)
SOLACE_INPUT_BROKER=tcp://solace-broker:55555
SOLACE_INPUT_VPN=default
SOLACE_INPUT_USERNAME=default
SOLACE_INPUT_PASSWORD=default

# Solace Broker — Output (publish validated results)
# Set to same as input for single-broker mode
SOLACE_OUTPUT_BROKER=tcp://solace-broker:55555
SOLACE_OUTPUT_VPN=default
SOLACE_OUTPUT_USERNAME=default
SOLACE_OUTPUT_PASSWORD=default

# For Solace Cloud dual-broker:
# SOLACE_INPUT_BROKER=wss://input-broker.messaging.solace.cloud:443
# SOLACE_INPUT_VPN=source-vpn
# SOLACE_INPUT_USERNAME=solace-cloud-client
# SOLACE_INPUT_PASSWORD=<input-password>
# SOLACE_OUTPUT_BROKER=wss://output-broker.messaging.solace.cloud:443
# SOLACE_OUTPUT_VPN=target-vpn
# SOLACE_OUTPUT_USERNAME=solace-cloud-client
# SOLACE_OUTPUT_PASSWORD=<output-password>

# Output topic routing
# Placeholders: {originalTopic} {schemaVersion} {mappingId} {outcome} {<topic-capture>}
# Default {originalTopic} republishes on the same topic (result carried in mi_validation_status).
# For single-broker / MQTT 3.1.1 consumers that route by result, embed {outcome}, e.g.:
#   VALIDATED_TOPIC_TEMPLATE={originalTopic}/{outcome}
#   REJECT_TOPIC_TEMPLATE={originalTopic}/{outcome}
#   PROCESSING_ERROR_TOPIC_TEMPLATE={originalTopic}/{outcome}
# VALIDATED_TOPIC_TEMPLATE={originalTopic}
# REJECT_TOPIC_TEMPLATE={originalTopic}
# PROCESSING_ERROR_TOPIC_TEMPLATE={originalTopic}
# Labels substituted for {outcome} (choose your vocabulary/casing):
# OUTCOME_LABEL_VALIDATED=valid
# OUTCOME_LABEL_REJECT=invalid
# OUTCOME_LABEL_PROCESSING_ERROR=error

# Schema Registry
SCHEMA_REGISTRY_BASE_URL=http://schema-registry-backend:8080/apis/registry/v3
SCHEMA_REGISTRY_USERNAME=sr-readonly
SCHEMA_REGISTRY_PASSWORD=roPassword

# Broker SEMP admin
SEMP_URL=http://solace-broker:8080
SEMP_ADMIN_USER=admin
SEMP_ADMIN_PASSWORD=admin

# Schema Registry distribution (download from products.solace.com; never committed)
SCHEMA_REGISTRY_VERSION=1.1.2
# SCHEMA_REGISTRY_DIST=/path/to/schema-registry-v1.1.2.tar.gz
# The default searches the repository and ~/Downloads.
# SCHEMA_REGISTRY_RUNTIME_DIR=/absolute/path/to/prepared-runtime

# Shared local Docker network (all four Compose files use the same project)
COMPOSE_PROJECT_NAME=schema-validation-mi
BROKER_SMF_HOST_PORT=55554
